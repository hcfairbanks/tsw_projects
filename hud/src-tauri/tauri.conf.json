{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TSW HUD",
  "version": "0.1.0",
  "identifier": "com.tsw.hud",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "shell",
        "title": "TSW HUD",
        "url": "index.html",
        "width": 1400,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}

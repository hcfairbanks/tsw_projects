hud-go/routes_data/

# hud (Tauri rewrite): build artifacts, the catalog DB, extractor output, and
# the deployed binary are heavy (~27 GB combined) and fully reproducible from
# source — keep them out of git (mirrors the hud-go rules above). The
# hand-authored resources (collections / widgets / views / flags / images /
# *.json) ARE committed; only the generated/large pieces below are ignored.
hud/src-tauri/target/
hud/hud.exe
hud/route_data/
hud/extractor_temp/
hud/resources/db/*.db
hud/resources/db/*.db-shm
hud/resources/db/*.db-wal
hud/resources/db/*.bak*

# 1. Get dependencies
go mod tidy

# 2. Build
go build -o tsw6-timetable.exe .

# 3. List all routes in your install
.\tsw6-timetable.exe list --tsw "C:\Program Files (x86)\Steam\steamapps\common\Train Sim World 6"

# 4. Extract everything to JSON
.\tsw6-timetable.exe extract \
  --tsw "C:\...\Train Sim World 6" \
  --uassetgui "C:\Tools\UAssetGUI\UAssetGUI.exe" \
  --format json \
  --out timetables.json \
  --verbose

# 5. Extract one route to CSV
.\tsw6-timetable.exe extract \
  --tsw "C:\...\Train Sim World 6" \
  --route BrightonMainLine \
  --format csv \
  --out brighton.csv